---
import Base from '../layouts/Base.astro';
---
<Base title="Signal lost">
  <div class="wrap" style="padding:120px 32px;display:flex;flex-direction:column;gap:18px">
    <p class="eyebrow">ERR 404 · LOSS OF SIGNAL</p>
    <h1 style="margin:0;font-family:var(--display);font-size:48px">This page is out of coverage.</h1>
    <p class="lead" style="margin:0">The link may have moved. Re-acquire from the ground station.</p>
    <div class="actions"><a class="btn primary" href="/">Back to home →</a></div>
  </div>
</Base>
